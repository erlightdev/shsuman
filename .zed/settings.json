{
  "context_servers": {
    "better-t-stack": {
      "source": "custom",
      "command": "npx",
      "args": ["create-better-t-stack@latest", "mcp"],
      "env": {}
    },
    "context7": {
      "source": "custom",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {}
    },
    "astro-docs": {
      "source": "custom",
      "type": "http",
      "url": "https://mcp.docs.astro.build/mcp",
      "headers": {}
    },
    "better-auth": {
      "source": "custom",
      "type": "http",
      "url": "https://mcp.better-auth.com/mcp",
      "headers": {}
    }
  }
}
