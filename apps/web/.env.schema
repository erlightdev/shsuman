# @defaultRequired=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# API server origin (auth, oRPC, uploads, MCP endpoint shown in the dashboard).
# Inlined into the client at build time, so set it when running the production build.
# Production: PUBLIC_SERVER_URL=https://api.shsuman.com.np
# astro.config.mjs fails a production build that uses localhost or http
# (set ALLOW_LOCAL_SERVER_URL=1 for a local test build).
# @public @type=url
PUBLIC_SERVER_URL=http://localhost:3000

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @sensitive @dynamic @required=false @type=string(minLength=1)
AXIOM_API_KEY=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @sensitive @dynamic @required=false @type=string(minLength=1)
AXIOM_DATASET=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @sensitive @dynamic @required=false @type=url
AXIOM_EDGE_URL=

