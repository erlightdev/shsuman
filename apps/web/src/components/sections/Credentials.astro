---
import type { SiteContent } from "@shsuman/api/content/schema";
import Icon from "@/components/common/Icon.astro";
import SectionHeader from "@/components/common/SectionHeader.astro";
import { ScrollReveal } from "@/components/motion/scroll-reveal";
import { AnimatedTooltip } from "@/components/ui/animated-tooltip";

interface Props {
  credentials: SiteContent["credentials"];
}

const { credentials } = Astro.props;
const { education, community, skills } = credentials;
---

<!-- Credentials — Education, Community Leadership & Skills -->
<section id="credentials" aria-labelledby="credentials-title" class="border-t border-border-line py-24 sm:py-32">
  <div class="container-site">
    <SectionHeader id="credentials-title" index="05" label="Credentials" title={credentials.title} />

    <ScrollReveal client:visible className="mt-12 grid gap-4 lg:grid-cols-3">
      {/* Education */}
      <article class="card p-6 sm:p-8">
        <h3 class="flex items-center gap-2 text-sm font-medium text-foreground-tertiary">
          <Icon name="graduation-cap" class="size-4 text-emerald-600 dark:text-emerald-400" />
          Education
        </h3>
        <ul class="mt-6 space-y-6">
          {education.map((item) => (
            <li>
              <p class="font-semibold text-foreground-primary">{item.degree}</p>
              <p class="mt-1 text-sm text-foreground-secondary">{item.school}</p>
              <p class="mt-1 font-mono text-sm tabular-nums text-foreground-tertiary">{item.location} · {item.year}</p>
            </li>
          ))}
        </ul>
      </article>

      {/* Community Leadership */}
      <article class="card p-6 sm:p-8 lg:col-span-2">
        <div class="flex flex-wrap items-center justify-between gap-6">
          <h3 class="flex items-center gap-2 text-sm font-medium text-foreground-tertiary">
            <Icon name="landmark" class="size-4 text-emerald-600 dark:text-emerald-400" />
            Community involvement & leadership
          </h3>
          <div class="flex pl-4">
            <AnimatedTooltip
              client:visible
              items={community.map((item, i) => ({
                id: i + 1,
                name: item.org,
                designation: item.role,
                image: item.logoUrl,
              }))}
            />
          </div>
        </div>
        <ul class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-2">
          {community.map((item) => (
            <li>
              <p class="font-semibold text-foreground-primary">{item.role}</p>
              <p class="text-sm text-foreground-secondary">
                {item.org}
                <span class="text-foreground-tertiary"> — {item.detail}</span>
              </p>
            </li>
          ))}
        </ul>
      </article>

      {/* Core Competencies */}
      <article class="card p-6 sm:p-8 lg:col-span-3">
        <h3 class="flex items-center gap-2 text-sm font-medium text-foreground-tertiary">
          <Icon name="shield" class="size-4 text-emerald-600 dark:text-emerald-400" />
          Core competencies
        </h3>
        <ul class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
          {skills.map((skill) => (
            <li class="flex items-start gap-3 text-foreground-primary">
              <Icon name="check" class="mt-1 size-4 text-brand-base" />
              {skill}
            </li>
          ))}
        </ul>
      </article>
    </ScrollReveal>
  </div>
</section>
