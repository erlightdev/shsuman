---
import type { SiteContent } from "@shsuman/api/content/schema";
import SectionHeader from "@/components/common/SectionHeader.astro";
import { ScrollReveal } from "@/components/motion/scroll-reveal";

interface Props {
  about: SiteContent["about"];
}

const { about } = Astro.props;
---

<!-- About — beUI Scroll Reveal -->
<section id="about" aria-labelledby="about-title" class="py-24 sm:py-32">
  <div class="container-site">
    <SectionHeader id="about-title" index="01" label="About" title={about.title} />

    <div class="mt-12 grid gap-12 lg:mt-16 lg:grid-cols-12 lg:gap-16">
      <ScrollReveal client:visible className="flex flex-col gap-6 lg:col-span-7">
        <p class="max-w-[62ch] text-xl leading-9 text-foreground-primary">{about.summary}</p>
        <p class="max-w-[62ch] text-lg leading-8 text-foreground-secondary">{about.passion}</p>
      </ScrollReveal>

      <ScrollReveal client:visible delay={0.1} className="flex flex-col gap-10 lg:col-span-5">
        <dl class="divide-y divide-border-line border-y border-border-line">
          {about.facts.map((fact) => (
            <div class="grid grid-cols-[7rem_1fr] gap-4 py-4">
              <dt class="text-sm leading-6 text-foreground-tertiary">{fact.term}</dt>
              <dd class="text-base leading-6 font-medium text-foreground-primary">{fact.detail}</dd>
            </div>
          ))}
        </dl>

        <div>
          <h3 class="text-sm text-foreground-tertiary">Interests</h3>
          <p class="mt-3 text-base leading-7 text-foreground-secondary">{about.interests.join(" · ")}</p>
        </div>
      </ScrollReveal>
    </div>
  </div>
</section>
