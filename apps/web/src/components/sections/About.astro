---
import type { SiteContent } from "@shsuman/api/content/schema";
import SectionHeader from "@/components/common/SectionHeader.astro";
import { ScrollReveal } from "@/components/motion/scroll-reveal";

interface Props {
  about: SiteContent["about"];
}

const { about } = Astro.props;
---

<!-- About — beUI Scroll Reveal -->
<section id="about" aria-labelledby="about-title" class="py-16">
  <div class="container-site">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeader id="about-title" index="01" label="About" title={about.title} />
      </div>

      <ScrollReveal client:visible className="lg:col-span-7 lg:pt-10">
        <p class="max-w-[38ch] text-2xl leading-snug font-medium text-foreground-primary sm:text-3xl sm:leading-snug">
          {about.summary}
        </p>
        <p class="mt-6 max-w-[56ch] text-lg leading-8 text-foreground-secondary">{about.passion}</p>
      </ScrollReveal>
    </div>

    <ScrollReveal client:visible delay={0.1} className="mt-16 sm:mt-20">
      <dl class="grid gap-y-8 border-t border-border-line pt-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-x-8">
        {about.facts.map((fact) => (
          <div>
            <dt class="text-sm text-foreground-tertiary">{fact.term}</dt>
            <dd class="mt-2 text-base leading-6 font-medium text-balance text-foreground-primary">{fact.detail}</dd>
          </div>
        ))}
      </dl>
      {about.interests.length > 0 && (
        <p class="mt-10 text-sm text-foreground-tertiary">
          Off the clock: <span class="text-foreground-secondary">{about.interests.join(", ")}</span>
        </p>
      )}
    </ScrollReveal>
  </div>
</section>
