---
import type { SiteContent } from "@shsuman/api/content/schema";
import BlogCard from "@/components/blog/BlogCard.astro";
import Icon from "@/components/common/Icon.astro";
import SectionHeader from "@/components/common/SectionHeader.astro";
import type { Post } from "@/lib/content";

interface Props {
  blog: SiteContent["blog"];
  posts: Post[];
}

const { blog } = Astro.props;
const posts = Astro.props.posts.slice(0, 3);
---

{posts.length > 0 && (
  <section id="blog" aria-labelledby="blog-title" class="border-t border-border-line py-24 sm:py-32">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeader id="blog-title" index="06" label="Blog" title={blog.title} lead={blog.lead} />
        <a href="/blog/" class="btn btn-outline">
          All articles
          <Icon name="arrow-up-right" />
        </a>
      </div>
      <ul class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <li>
            <BlogCard post={post} />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
