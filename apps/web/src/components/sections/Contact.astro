---
import type { SiteContent } from "@shsuman/api/content/schema";
import Icon from "@/components/common/Icon.astro";
import { StudioBackground } from "@/components/ui/studio-background";
import { ContactLinks } from "./ContactLinks";

interface Props {
	contact: SiteContent["contact"];
	footer: SiteContent["footer"];
	name: string;
}

const { contact, footer, name } = Astro.props;
const links = contact.links.map((link) => ({
	...link,
	external: /^https?:/.test(link.href),
}));
---

<!-- Contact — OGL Fluid Shader Background + beUI Magnetic + Skiper UI Text Roll navigation + Footer -->
<section id="contact" aria-labelledby="contact-title" class="border-t border-border-line py-8 sm:py-12 px-3 sm:px-6 lg:px-8">
  <div class="relative w-full overflow-hidden rounded-[28px] bg-[#03120a] shadow-2xl">
    <!-- WebGL OGL Animated Canvas -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <StudioBackground client:visible />
    </div>

    <!-- Contrast Scrim for Clear Text Readability -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/55 via-black/35 to-black/65 backdrop-blur-[0.5px]"
    />

    <!-- Inset ring overlay -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 rounded-[28px] ring-1 ring-white/10 ring-inset"
    />

    <!-- Content Container -->
    <div class="relative z-10 max-w-7xl mx-auto p-6 sm:p-10 lg:p-14">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5 flex flex-col justify-between">
          <div>
            <h2
              id="contact-title"
              class="text-2xl font-semibold tracking-tight text-white sm:text-3xl lg:text-4xl font-display text-balance"
            >
              {contact.title}
            </h2>

            <p class="mt-3 text-sm sm:text-base text-emerald-100/75 text-pretty leading-relaxed">
              {contact.lead}
            </p>
          </div>

          <address class="mt-8 flex items-start gap-3 not-italic text-xs sm:text-sm text-white/70">
            <Icon name="map-pin" class="mt-0.5 size-4 text-emerald-400 shrink-0" />
            {contact.location}
          </address>
        </div>

        <div class="lg:col-span-7">
          <ContactLinks client:visible email={contact.email} links={links} darkTheme />
        </div>
      </div>

      <!-- Integrated Footer Row inside the Card -->
      <div class="mt-12 border-t border-white/10 pt-6 flex flex-col gap-4 text-xs text-white/60 sm:flex-row sm:items-center sm:justify-between">
        <p>&copy; {new Date().getFullYear()} {name}. {footer.note}</p>
        <nav aria-label="Footer" class="flex items-center gap-6">
          <a href="#" class="inline-flex items-center gap-1.5 hover:text-white transition-colors">
            Back to top
            <Icon name="arrow-up" class="size-3.5" />
          </a>
        </nav>
      </div>
    </div>
  </div>
</section>



