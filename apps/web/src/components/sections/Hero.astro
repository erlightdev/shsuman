---
import type { SiteContent } from "@shsuman/api/content/schema";
import Icon from "@/components/common/Icon.astro";
import { NumberTicker } from "@/components/motion/number-ticker";
import { StudioBackground } from "@/components/ui/studio-background";
import { LayoutTextFlip } from "@/components/ui/layout-text-flip";

interface Props {
  profile: SiteContent["profile"];
  hero: SiteContent["hero"];
}

const { profile, hero } = Astro.props;

const portraitUrl =
  profile.portraitUrl &&
  !profile.portraitUrl.includes("suman-sharma.jpeg")
    ? profile.portraitUrl
    : "/suman-k-sharma.webp";

const stats = hero.stats.map((stat) => {
  const match = stat.value.match(/^(\d+)(\D*)$/);
  return { ...stat, number: match ? Number(match[1]) : null, suffix: match?.[2] ?? "" };
});
---

<!-- Hero — OGL Fluid Shader Background + Layout Text Flip, beUI Number Ticker -->
<section id="top" aria-labelledby="hero-title" class="py-3 sm:py-4 lg:py-5 px-3 sm:px-6 lg:px-8">
  <div class="relative w-full overflow-hidden rounded-[26px] bg-[#03120a] shadow-2xl">
    <!-- WebGL OGL Animated Canvas -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <StudioBackground client:load />
    </div>

    <!-- Contrast Scrim for Clear Text Readability -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/55 via-black/35 to-black/65 backdrop-blur-[0.5px]"
    />

    <!-- Inset ring overlay -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 rounded-[26px] ring-1 ring-white/10 ring-inset"
    />

    <!-- Content Container -->
    <div class="relative z-10 max-w-7xl mx-auto p-5 sm:p-7 lg:p-9 xl:p-10">
      <div class="grid items-center gap-6 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-7">
          <p class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/15 px-3 py-1 text-xs font-medium text-white shadow-xs backdrop-blur-md">
            <span class="relative flex size-1.5">
              <span class="absolute inset-0 rounded-full bg-emerald-400 opacity-40 motion-safe:animate-ping"></span>
              <span class="relative size-1.5 rounded-full bg-emerald-400"></span>
            </span>
            {profile.currentTitle}, {profile.currentCompany}
          </p>

          <h1 id="hero-title" class="mt-3.5 text-3xl font-semibold text-white tracking-tight sm:text-4xl lg:text-5xl text-balance">
            {profile.name}
          </h1>

          <p class="mt-2 font-serif text-xl italic text-emerald-100/90 sm:text-2xl">
            <span class="sr-only">{profile.role}</span>
            <span aria-hidden="true" class="flex flex-wrap items-center gap-x-2 gap-y-1.5">
              <LayoutTextFlip client:load text={hero.flipPrefix} words={hero.flipWords} duration={2600} />
            </span>
          </p>

          <p class="mt-3.5 max-w-xl text-xs sm:text-sm leading-relaxed text-white/80 text-pretty">
            {hero.lead}
          </p>

          <div class="mt-5 flex flex-wrap gap-2.5">
            <a
              href="#contact"
              class="inline-flex items-center gap-2 rounded-full bg-white px-4.5 py-2 text-xs sm:text-sm font-semibold text-neutral-950 transition-all hover:bg-neutral-100 shadow-md hover:shadow-lg"
            >
              Get in touch
              <Icon name="arrow-up-right" class="size-3.5" />
            </a>
            <a
              href={profile.cvUrl}
              download
              class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/15 px-4.5 py-2 text-xs sm:text-sm font-medium text-white backdrop-blur-md transition-all hover:bg-white/20"
            >
              <Icon name="download" class="size-3.5" />
              Download CV
            </a>
          </div>
        </div>

        <figure class="lg:col-span-5 flex justify-center lg:justify-end">
          <div class="relative w-full max-w-[260px] sm:max-w-[290px] lg:max-w-[330px] overflow-hidden rounded-2xl bg-neutral-900/60 ring-1 ring-white/15 shadow-2xl">
            <img
              src={portraitUrl}
              width="1024"
              height="1024"
              alt={profile.portraitAlt}
              fetchpriority="high"
              decoding="async"
              class="aspect-[4/4.5] w-full object-cover object-top"
            />
            <figcaption class="absolute inset-x-2.5 bottom-2.5 flex items-center justify-between gap-2 rounded-xl bg-black/75 px-3 py-1.5 text-xs ring-1 ring-white/15 backdrop-blur-md text-white">
              <span class="flex items-center gap-1.5 text-white/90 font-medium">
                <Icon name="map-pin" class="size-3.5 text-emerald-400" />
                {profile.location}
              </span>
              <span class="text-white/70">{profile.highlightRole}</span>
            </figcaption>
          </div>
        </figure>
      </div>

      <div class="mt-6 sm:mt-8 border-t border-white/10 pt-4 sm:pt-5">
        <dl class="grid divide-x divide-white/10" style={`grid-template-columns: repeat(${stats.length}, minmax(0, 1fr))`}>
          {stats.map((stat, i) => (
            <div class:list={["px-3 py-1.5 sm:px-5 sm:py-2", i === 0 && "pl-0 sm:pl-0"]}>
              <dt class="text-xs text-white/60">{stat.label}</dt>
              <dd class="mt-0.5 text-xl font-semibold tabular-nums text-white sm:text-2xl lg:text-3xl">
                {stat.number !== null ? <NumberTicker client:visible value={stat.number} suffix={stat.suffix} /> : stat.value}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>
