---
// Generative cover art for posts, so every article has a consistent visual without stock images.
interface Props {
  variant: "rings" | "wave" | "fan";
  class?: string;
  /** Adds a centered badge, used on the auth screen */
  badge?: boolean;
}

const { variant, class: className, badge = false } = Astro.props;

const palettes = {
  rings: { from: "#eef5e6", to: "#d6e6c3", a: "#8fb573", b: "#3f6f3a" },
  wave: { from: "#eef6f7", to: "#c9e3e6", a: "#9cc9d1", b: "#3f7f8c" },
  fan: { from: "#fbf0e6", to: "#f3cfae", a: "#e7a47c", b: "#b5613f" },
} as const;

const p = palettes[variant];
const id = `cover-${variant}-${Math.random().toString(36).slice(2, 8)}`;
const rings = Array.from({ length: 8 }, (_, i) => i);
const petals = Array.from({ length: 9 }, (_, i) => i);
const ribbons = Array.from({ length: 7 }, (_, i) => i);
---

<div class:list={["relative overflow-hidden", className]} aria-hidden="true">
  <svg viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice" class="block size-full">
    <defs>
      <linearGradient id={`${id}-bg`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color={p.from} />
        <stop offset="1" stop-color={p.to} />
      </linearGradient>
      <linearGradient id={`${id}-fg`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color={p.a} />
        <stop offset="1" stop-color={p.b} />
      </linearGradient>
    </defs>
    <rect width="400" height="250" fill={`url(#${id}-bg)`} />

    {variant === "rings" &&
      rings.map((i) => (
        <circle
          cx={196 + i * 5}
          cy={128 - i * 3}
          r={96 - i * 10}
          fill="none"
          stroke={`url(#${id}-fg)`}
          stroke-width="9"
          opacity={0.55 + i * 0.05}
        />
      ))}

    {variant === "wave" &&
      ribbons.map((i) => (
        <path
          d={`M -20 ${210 - i * 6} C 80 ${210 - i * 6}, 110 ${40 + i * 4}, 200 ${60 + i * 4} S 330 ${200 - i * 5}, 420 ${120 - i * 6}`}
          fill="none"
          stroke={`url(#${id}-fg)`}
          stroke-width="14"
          stroke-linecap="round"
          opacity={0.25 + i * 0.1}
        />
      ))}

    {variant === "fan" &&
      petals.map((i) => (
        <rect
          x="200"
          y="118"
          width="120"
          height="34"
          rx="17"
          fill={`url(#${id}-fg)`}
          opacity={0.45 + i * 0.06}
          transform={`rotate(${-160 + i * 20} 200 135)`}
        />
      ))}
  </svg>

  {badge && (
    <span class="absolute top-1/2 left-1/2 grid size-20 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white/80 text-neutral-900 shadow-lg ring-1 ring-black/5 backdrop-blur">
      <slot />
    </span>
  )}
</div>
