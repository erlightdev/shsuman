---
import type { Post } from "@/lib/content";
import { formatDate } from "@/lib/markdown";
import BlogCover from "./BlogCover.astro";

interface Props {
  post: Post;
  headingLevel?: "h2" | "h3";
}

const { post, headingLevel: Heading = "h3" } = Astro.props;
const { slug, title, category, publishedAt, cover, coverImage } = post;
const date = new Date(publishedAt);
---

<article class="group relative flex h-full flex-col rounded-[1.75rem] border border-border bg-background p-3 transition-colors hover:border-border-tertiary">
  {coverImage ? (
    <img src={coverImage} alt="" loading="lazy" decoding="async" class="aspect-[16/10] w-full rounded-[1.25rem] object-cover" />
  ) : (
    <BlogCover variant={cover as "rings" | "wave" | "fan"} class="aspect-[16/10] rounded-[1.25rem]" />
  )}
  <div class="flex flex-1 flex-col px-3 pt-6 pb-3">
    <p class="font-mono text-xs uppercase text-muted-foreground">{category}</p>
    <Heading class="mt-3 text-xl leading-snug font-medium text-foreground">
      <a href={`/blog/${slug}/`} class="after:absolute after:inset-0 after:rounded-[1.75rem] focus-visible:outline-none">
        {title}
      </a>
    </Heading>
    <time datetime={date.toISOString()} class="mt-auto pt-6 text-sm text-muted-foreground">
      {formatDate(date)}
    </time>
  </div>
</article>

<style>
  article:has(a:focus-visible) {
    outline: 2px solid var(--brand-base);
    outline-offset: 3px;
  }
</style>
