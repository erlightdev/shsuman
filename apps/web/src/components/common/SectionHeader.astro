---
import { ScrollReveal } from "@/components/motion/scroll-reveal";

interface Props {
  id: string;
  index: string;
  label: string;
  title: string;
  lead?: string;
}

const { id, index, label, title, lead } = Astro.props;
---

<ScrollReveal client:visible className="max-w-2xl">
<header>
  <p class="eyebrow flex items-center gap-2">
    <span class="text-brand-base">{index}</span>
    <span aria-hidden="true" class="h-px w-6 bg-border-tertiary"></span>
    <span>{label}</span>
  </p>
  <h2 id={id} class="mt-4 text-3xl font-semibold sm:text-4xl">{title}</h2>
  {lead && <p class="mt-4 text-base leading-7 text-foreground-secondary sm:text-lg sm:leading-8">{lead}</p>}
</header>
</ScrollReveal>
