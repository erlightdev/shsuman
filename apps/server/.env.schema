# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Public origin of this API server. Use https in production: it switches auth
# cookies to SameSite=None; Secure so the site and API can share a session.
# Production: BETTER_AUTH_URL=https://api.shsuman.com.np
# @type=url @sensitive=false
BETTER_AUTH_URL=

# Origin of the web app allowed to call this API with cookies.
# Production: CORS_ORIGIN=https://shsuman.com.np
# @type=url @sensitive=false
CORS_ORIGIN=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_API_KEY=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_DATASET=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=url
AXIOM_EDGE_URL=

# @type=string(minLength=1)
DATABASE_URL=
